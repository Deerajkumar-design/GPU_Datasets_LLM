# SEC EDGAR requires a descriptive User-Agent with a REAL, reachable contact address.
# See https://www.sec.gov/os/webmaster-faq#developers
# Do NOT use a fabricated address. Requests are rate limited to <=10 req/s by the adapter.
SEC_USER_AGENT="Your Org Name your.real.contact@example.com"

# openFDA works without a key but is rate limited (240 req/min, 1000 req/day).
# An optional key raises limits: https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# ClinicalTrials.gov API v2 and the World Bank Indicators API need no credentials.

FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git git-lfs python3 python3-pip python3-venv && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/longctx
COPY requirements-b200.txt pyproject.toml README.md ./
COPY src ./src
RUN python3 -m pip install --break-system-packages -r requirements-b200.txt && \
    python3 -m pip install --break-system-packages --no-deps .

CMD ["bash"]

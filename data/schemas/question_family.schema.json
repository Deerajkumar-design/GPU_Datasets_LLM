{
  "$defs": {
    "AnswerType": {
      "enum": [
        "NUMERIC",
        "PERCENT",
        "INTEGER",
        "STRING",
        "DATE",
        "CATEGORICAL",
        "INSUFFICIENT_EVIDENCE"
      ],
      "title": "AnswerType",
      "type": "string"
    },
    "CalculationOp": {
      "description": "Deterministic operations permitted for RETRIEVAL_CALCULATION gold answers.",
      "enum": [
        "ratio_percent",
        "growth_percent",
        "difference",
        "ratio",
        "sum",
        "count",
        "days_between"
      ],
      "title": "CalculationOp",
      "type": "string"
    },
    "CalculationSpec": {
      "additionalProperties": false,
      "description": "Explicit, replayable definition of a derived gold answer.\n\n``operands`` maps a role name to a record ID; ``operand_values`` maps the same role\nto the numeric value used. The validator recomputes the answer from these and fails\nhard on mismatch, so an answer can never drift away from its source records.",
      "properties": {
        "denominator_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator Record Id"
        },
        "formula": {
          "title": "Formula",
          "type": "string"
        },
        "numerator_record_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator Record Id"
        },
        "operand_values": {
          "additionalProperties": {
            "type": "number"
          },
          "description": "role -> numeric value",
          "title": "Operand Values",
          "type": "object"
        },
        "operands": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "role -> record_id",
          "title": "Operands",
          "type": "object"
        },
        "operation": {
          "$ref": "#/$defs/CalculationOp"
        },
        "raw_result": {
          "title": "Raw Result",
          "type": "number"
        },
        "result_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Unit"
        },
        "round_decimals": {
          "default": 2,
          "title": "Round Decimals",
          "type": "integer"
        },
        "rounded_result": {
          "title": "Rounded Result",
          "type": "number"
        }
      },
      "required": [
        "operation",
        "formula",
        "operands",
        "operand_values",
        "raw_result",
        "rounded_result"
      ],
      "title": "CalculationSpec",
      "type": "object"
    },
    "Domain": {
      "description": "Domains with an implemented source adapter.",
      "enum": [
        "SEC",
        "FDA",
        "CLINICAL_TRIALS",
        "WORLD_BANK",
        "EXTENSION"
      ],
      "title": "Domain",
      "type": "string"
    },
    "GenerationMetadata": {
      "additionalProperties": false,
      "description": "Everything required to reproduce this family bit-for-bit.",
      "properties": {
        "config_hash": {
          "title": "Config Hash",
          "type": "string"
        },
        "generated_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated At"
        },
        "generator_version": {
          "default": "0.1.0",
          "title": "Generator Version",
          "type": "string"
        },
        "git_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Git Commit"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "template_id": {
          "title": "Template Id",
          "type": "string"
        },
        "template_version": {
          "default": "1.0.0",
          "title": "Template Version",
          "type": "string"
        },
        "tokenizer_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokenizer Id"
        }
      },
      "required": [
        "template_id",
        "seed",
        "config_hash"
      ],
      "title": "GenerationMetadata",
      "type": "object"
    },
    "GoldEvidence": {
      "additionalProperties": false,
      "description": "A record the gold answer is derived from, denormalized for re-verification.\n\nDenormalization is deliberate: the family file must stay self-verifiable even if\nthe normalized layer is regenerated from refreshed live data.",
      "properties": {
        "concept": {
          "title": "Concept",
          "type": "string"
        },
        "concept_label": {
          "title": "Concept Label",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "entity_name": {
          "title": "Entity Name",
          "type": "string"
        },
        "metadata": {
          "title": "Metadata",
          "type": "object"
        },
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "role": {
          "default": "evidence",
          "description": "Role in the answer, e.g. 'numerator'.",
          "title": "Role",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "value_numeric": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Numeric"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        }
      },
      "required": [
        "record_id",
        "entity_id",
        "entity_name",
        "concept",
        "concept_label",
        "value"
      ],
      "title": "GoldEvidence",
      "type": "object"
    },
    "QuestionType": {
      "description": "The five question categories the study distinguishes.",
      "enum": [
        "DIRECT_RETRIEVAL",
        "RETRIEVAL_CALCULATION",
        "TEMPORAL_VERSION",
        "ENTITY_UNIT_BINDING",
        "UNANSWERABLE"
      ],
      "title": "QuestionType",
      "type": "string"
    },
    "SourceProvenance": {
      "additionalProperties": false,
      "description": "Where the family's data came from, at API-call granularity.",
      "properties": {
        "api_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Api Version"
        },
        "endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "license_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Note"
        },
        "record_ids": {
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "request_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Url"
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retrieved At"
        },
        "source": {
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "title": "SourceProvenance",
      "type": "object"
    },
    "UnanswerableSpec": {
      "additionalProperties": false,
      "description": "Why a family is unanswerable, and what must stay absent for it to remain so.",
      "properties": {
        "forbidden_concept_aliases": {
          "description": "Concepts that would disclose the answer if present; the leakage checker treats any of these matching the target conditions as a failure.",
          "items": {
            "type": "string"
          },
          "title": "Forbidden Concept Aliases",
          "type": "array"
        },
        "missing_concept": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Concept"
        },
        "missing_entity_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Entity Id"
        },
        "missing_period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Period"
        },
        "reason": {
          "description": "Human-readable justification.",
          "title": "Reason",
          "type": "string"
        },
        "reason_code": {
          "description": "e.g. 'FIELD_NOT_REPORTED_BY_ENTITY', 'PERIOD_NOT_COVERED', 'RESULTS_NOT_POSTED'.",
          "title": "Reason Code",
          "type": "string"
        },
        "verified_absent_in_pool": {
          "default": false,
          "description": "True once the generator has confirmed no record in the domain pool satisfies the target conditions.",
          "title": "Verified Absent In Pool",
          "type": "boolean"
        }
      },
      "required": [
        "reason_code",
        "reason"
      ],
      "title": "UnanswerableSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The experimental unit: one question, one gold answer, many context lengths.",
  "properties": {
    "answer_type": {
      "$ref": "#/$defs/AnswerType"
    },
    "answer_unit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer Unit"
    },
    "answerable": {
      "title": "Answerable",
      "type": "boolean"
    },
    "calculation_spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalculationSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "generation_metadata": {
      "$ref": "#/$defs/GenerationMetadata"
    },
    "gold_answer": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Gold Answer"
    },
    "gold_answer_normalized": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        }
      ],
      "title": "Gold Answer Normalized"
    },
    "gold_evidence": {
      "items": {
        "$ref": "#/$defs/GoldEvidence"
      },
      "title": "Gold Evidence",
      "type": "array"
    },
    "gold_evidence_ids": {
      "items": {
        "type": "string"
      },
      "title": "Gold Evidence Ids",
      "type": "array"
    },
    "numeric_tolerance": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Absolute tolerance for numeric grading; None for non-numeric.",
      "title": "Numeric Tolerance"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "question_family_id": {
      "title": "Question Family Id",
      "type": "string"
    },
    "question_type": {
      "$ref": "#/$defs/QuestionType"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_name": {
      "title": "Source Name",
      "type": "string"
    },
    "source_provenance": {
      "items": {
        "$ref": "#/$defs/SourceProvenance"
      },
      "title": "Source Provenance",
      "type": "array"
    },
    "target_conditions": {
      "description": "Structured description of exactly which record(s) answer the question. Drives both distractor selection and leakage detection.",
      "title": "Target Conditions",
      "type": "object"
    },
    "unanswerable_spec": {
      "anyOf": [
        {
          "$ref": "#/$defs/UnanswerableSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "question_family_id",
    "domain",
    "source_name",
    "question_type",
    "question",
    "answerable",
    "gold_answer",
    "gold_answer_normalized",
    "answer_type",
    "generation_metadata"
  ],
  "title": "QuestionFamily",
  "type": "object"
}
